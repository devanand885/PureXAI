# PureXAI Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed

APP_NAME="PureXAI Water Quality Monitor"
APP_VERSION="1.0.0"
DEBUG=True

# Network Host & Port
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite default, can point to PostgreSQL)
DATABASE_URL=sqlite:///./data/purexai.db

# Optional Notifications (extensible)
NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT=587
